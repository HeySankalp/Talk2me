<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <title>Join Meeting - Datopic Technology</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <style>
        html,
        body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
        }

        body {
            display: flex;
            flex-direction: column;
            font-family: Roboto, sans-serif;
            background: #f1f3f4;
        }

        /* Prejoin & meeting wrappers should fill the remaining space */
        #prejoinView,
        #meetingView {
            flex: 1 1 auto;
            position: relative;
            display: flex;
            width: 100%;
        }

        /* Prejoin side layout */
        #prejoinView .flex-grow-1 {
            flex: 1;
        }

        /* Meeting video area */
        .meeting-videos {
            padding: 5px;
            position: relative;
            width: 100%;
            height: 100%;
            background: #ffffff;
            overflow: hidden;
        }

        .meeting-videos video {
            object-fit: cover;
        }

        #meetingRemoteVideo {
            width: 100%;
            height: 100%;
            background-color: #000;
        }

        #meetingLocalVideo {
            position: absolute;
            width: 200px;
            height: 150px;
            bottom: 90px;
            right: 20px;
            border: 2px solid #fff;
            background: #000;
            object-fit: cover;
        }

        .action_button {
            position: absolute;
            right: 0%;
            left: 0%;
            bottom: 32%;
        }

        .meeting-controls {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            display: flex;
            gap: 12px;
        }

        .video-container {
            flex: 1;
            padding: 1rem;
            overflow: auto;
            background-color: #1a1a1a;
        }

        .video-grid {
            display: grid;
            gap: 1rem;
            height: 100%;
            grid-auto-rows: 1fr;
            padding-bottom: 60px;
        }

        .video-grid.cols-1 {
            grid-template-columns: 1fr;
        }

        .video-grid.cols-2 {
            grid-template-columns: repeat(2, 1fr);
        }

        .video-grid.cols-3 {
            grid-template-columns: repeat(3, 1fr);
        }

        .video-grid.cols-4 {
            grid-template-columns: repeat(4, 1fr);
        }

        .participant-box {
            background: linear-gradient(135deg, #3a3a3a 0%, #2d2d2d 100%);
            border-radius: 0.75rem;
            position: relative;
            min-height: 200px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            transition: all 0.3s;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }

        .participant-box:hover {
            box-shadow: 0 0 0 3px #1a73e8;
            /* transform: scale(1.01); */
        }

        .video-elm {
            width: 100%;
            height: 100%;
            background: black;

        }

        .avatar_placeholder {
            background-color: #000000;
            position: absolute;
            display: flex;
            justify-content: center;
            align-items: center;
            width: 100%;
            height: 100%;
            z-index: 2;
        }

        .initials-circle {
            right: 0%;
            left: 0;
            top: 0%;
            bottom: 0%;
            width: 150px;
            height: 150px;
            border-radius: 50%;
            font-size: 4rem;
            color: white;
            display: flex;
            justify-content: center;
            align-items: center;
            user-select: none;
            margin: auto;
            font-weight: 400;
        }

        .name-tag {
            position: absolute;
            bottom: 1rem;
            left: 1rem;
            background: rgba(0, 0, 0, 0.7);
            color: white;
            padding: 0.5rem 0.75rem;
            border-radius: 0.375rem;
            font-size: 0.875rem;
            z-index: 3;
        }
    </style>
</head>

<body>
    <!-- Pre-join UI -->
    <div id="prejoinView" class="d-flex w-100">
        <div
            class="d-flex flex-column justify-content-center flex-grow-1 bg-white border-end position-relative px-4 py-5">
            <img src="https://www.datopic.com/assets/img/logo/logo.png" alt="Datopic Technology Logo"
                class="position-absolute" style="top:20px; left:20px; width:220px;" crossorigin="anonymous" />
            <div class="container">
                <h1 class="display-4 fw-normal mb-2" style="color:#1a73e8;">Join a Meeting</h1>
                <p class="text-secondary mb-0">Please allow camera and microphone access to preview the video and join
                    the meeting.</p>
            </div>
        </div>

        <div class="d-flex flex-column justify-content-center align-items-center flex-grow-1 p-3 p-md-4">
            <div class="card shadow-sm w-100" style="max-width:500px; border-radius:16px;">
                <div class="card-body text-center p-4">
                    <div class="bg-black rounded w-100 mb-3 d-flex align-items-center justify-content-center"
                        style="height:350px; overflow:hidden;">
                        <video id="localVideo" autoplay playsinline muted class="w-100 h-100"
                            style="object-fit:cover; transform:scaleX(-1);"></video>
                    </div>

                    <div id="errorMsg" class="text-danger small mb-2"></div>

                    <div class=" action_button d-flex justify-content-center gap-2 mb-3 ">
                        <button id="toggleVideoBtn"
                            class="btn btn-outline-light  d-inline-flex align-items-center gap-2" disabled>
                            <i class="bi bi-camera-video-fill" id="videoIcon"></i>
                            <!-- <span id="videoLabel"></span> -->
                        </button>
                        <button id="toggleAudioBtn" class="btn btn-outline-light d-inline-flex align-items-center gap-2"
                            disabled>
                            <i class="bi bi-mic-fill" id="audioIcon"></i>
                            <!-- <span id="audioLabel"></span> -->
                        </button>
                    </div>

                    <input type="text" id="username" class="form-control mb-3" placeholder="Your Name (optional)" />
                    <input type="text" id="roomname" class="form-control mb-3" placeholder="Room name" />

                    <button id="joinBtn" class="btn btn-primary w-100" disabled>Join</button>
                </div>
            </div>
            <div id="existing_user" class="text-center text-secondary mt-3">

            </div>
        </div>
    </div>

    <!-- Meeting UI -->
    <div id="meetingView" class="d-none w-100 h-100 position-relative">
        <!-- <div class="meeting-videos"> -->
        <!-- <video id="meetingRemoteVideo" autoplay playsinline class="w-100 h-100"></video> -->
        <!-- <video id="meetingLocalVideo" autoplay playsinline muted></video> -->
        <!-- </div> -->

        <div class="video-container">
            <div class="video-grid" id="videoGrid">
                <!-- Participants will be added here -->

            </div>
        </div>

        <div class="meeting-controls">
            <button id="meetingVideoBtn" class="btn btn-light d-inline-flex align-items-center gap-2">
                <i class="bi bi-camera-video-fill" id="meetingVideoIcon"></i>

            </button>
            <button id="meetingAudioBtn" class="btn btn-light d-inline-flex align-items-center gap-2">
                <i class="bi bi-mic-fill" id="meetingAudioIcon"></i>

            </button>
            <button id="endCallBtn" class="btn btn-danger d-inline-flex align-items-center gap-2">
                <i class="bi bi-telephone-x-fill"></i>

            </button>
        </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/media.js"></script>
</body>

</html>